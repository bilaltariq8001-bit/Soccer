<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pitchside" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#07111F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch theme: shown until preferences are loaded (installSplashScreen in MainActivity). -->
    <style name="Theme.Pitchside.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07111F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pitchside</item>
    </style>
</resources>
