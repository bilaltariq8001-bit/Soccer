{
  "name": "pitchside-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:emu": "vitest run --config vitest.emu.config.ts",
    "test:emulated": "firebase emulators:exec --config ../firebase.json --project demo-pitchside --only firestore \"npm run test:emu\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^20.16.0",
    "firebase": "^13.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
